{
  "name": "@xyflow/monorepo",
  "version": "0.0.0",
  "description": "A highly customizable React library for building node-based editors and interactive flow charts",
  "repository": "git@github.com:xyflow/xyflow.git",
  "license": "MIT",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev --parallel --concurrency 12",
    "dev:svelte": "turbo run dev --filter=storybook-svelte...",
    "dev:react": "turbo run dev --filter=storybook-react...",
    "dev:vue": "turbo run dev --filter=storybook-vue...",
    "storybook": "pnpm --filter 'storybook-*' --parallel dev",
    "test:storybook": "pnpm --filter 'storybook-*' --if-present test-storybook",
    "build:all": "turbo run build",
    "build": "turbo run build --filter=./packages/**",
    "format": "turbo run format --filter=./packages/**",
    "lint": "turbo run lint --filter=./packages/**",
    "typecheck": "turbo run typecheck --filter=./packages/**",
    "release": "changeset publish",
    "clean": "pnpm -r --parallel exec rimraf dist .turbo node_modules",
    "test:cypress": "pnpm --filter storybook-react test:component && pnpm --filter storybook-react test:e2e"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.15",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.4"
}
