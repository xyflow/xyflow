{
  "name": "@xyflow/monorepo",
  "version": "0.0.0",
  "description": "A highly customizable React library for building node-based editors and interactive flow charts",
  "repository": "git@github.com:xyflow/xyflow.git",
  "license": "MIT",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev --parallel --concurrency 12",
    "dev:svelte": "turbo run dev --filter=svelte-examples...",
    "dev:react": "turbo run dev --filter=react-examples...",
    "dev:vue": "turbo run dev --filter=storybook-vue...",
    "storybook": "concurrently -n react,svelte,vue,shared -c blue,magenta,cyan,green \"pnpm --filter=storybook-react run storybook:serve\" \"pnpm --filter=storybook-svelte run storybook:serve\" \"pnpm --filter=storybook-vue run storybook:serve\" \"pnpm --filter=storybook-shared run storybook\"",
    "storybook:react": "pnpm --filter=storybook-react run storybook",
    "storybook:svelte": "pnpm --filter=storybook-svelte run storybook",
    "storybook:vue": "pnpm --filter=storybook-vue run storybook",
    "test:storybook": "pnpm --filter storybook-react run test-storybook && pnpm --filter storybook-svelte run test-storybook",
    "test:storybook:react": "pnpm --filter storybook-react run test-storybook",
    "test:storybook:svelte": "pnpm --filter storybook-svelte run test-storybook",
    "test:cypress:react": "pnpm --filter storybook-react test:e2e",
    "build:all": "turbo run build",
    "build": "turbo run build --filter=./packages/**",
    "format": "turbo run format --filter=./packages/**",
    "lint": "turbo run lint --filter=./packages/**",
    "typecheck": "turbo run typecheck --filter=./packages/**",
    "release": "changeset publish",
    "clean": "pnpm -r --parallel exec rimraf dist .turbo node_modules"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "concurrently": "^10.0.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.15",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.4"
}
