{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["cypress", "cypress-real-events", "vite/client"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../cypress.config.ts"]
}
